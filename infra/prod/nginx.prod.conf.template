server {

    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    keepalive_timeout          45;
    reset_timedout_connection  on;
    client_body_timeout        35;
    send_timeout               30;

    server_name goodstart-education-bot.ru;

    include /config/nginx/ssl.conf;

    client_max_body_size 10M;

    # ДОБАВЬТЕ ЭТОТ БЛОК ДЛЯ ТЕЛЕГРАМА
    location /telegram-proxy/ {
        # Перенаправляем запросы на ваш пустой сервер
        proxy_pass http://195.133.8; 
        
        proxy_set_header Host api.telegram.org;
        proxy_ssl_server_name on;

        proxy_connect_timeout 15s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    location /admin {
      proxy_set_header Host $http_host;
      proxy_set_header        X-Real-IP $remote_addr;
      proxy_set_header        X-Forwarded-Proto $scheme;
      proxy_pass http://bot:8000/admin;
    }
    location /media {
      alias /media/;
    }
    location /static {
      alias /static/;
    }
    location /schedule {
      proxy_set_header Host $http_host;
      proxy_set_header        X-Real-IP $remote_addr;
      proxy_set_header        X-Forwarded-Proto $scheme;
      proxy_pass http://bot:8000/schedule;
    }
    location /registration {
      proxy_set_header Host $http_host;
      proxy_set_header        X-Real-IP $remote_addr;
      proxy_set_header        X-Forwarded-Proto $scheme;
      proxy_pass http://bot:8000/registration;
    }
    location / {
      proxy_pass http://bot:8000/admin;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
}


server {
    if ($host = goodstart-education-bot.ru) {
        return 301 https://$host$request_uri;
    }

  listen 80;
  server_name goodstart-education-bot.ru;
    return 301 https://$host$request_uri;

}
